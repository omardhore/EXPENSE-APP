# Copy to .env and fill in your Supabase project values (same project the
# web app uses). Expo only inlines vars prefixed EXPO_PUBLIC_ into the app
# bundle, so these are the anon (public) key only — never the service role
# key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed web app, used only for the two account-lifecycle
# endpoints (delete account, clear workspace data) that need server-side
# service-role privileges. e.g. https://your-app.vercel.app
EXPO_PUBLIC_API_URL=
